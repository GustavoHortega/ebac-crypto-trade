{
  "name": "crypto-trade",
  "version": "0.0.1",
  "description": "Uma aplicação simples, API only, desenvolvida no curso de node JS da ebac (https://ebaconline.com.br/node-js) para simular uma corretora de crypto",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon ./server.js",
    "seed": "node ./seed",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:int": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand -c jest.integracao.config.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.18.1",
    "bcrypt": "^5.0.1",
    "bull": "^4.16.5",
