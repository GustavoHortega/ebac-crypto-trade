    "crypto": "^1.0.1",
    "dotenv": "^16.0.1",
    "ejs": "^7.0.1",
    "express": "^4.18.1",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^6.5.3",
    "nodemailer": "^10.0.15",
    "otplib": "^13.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "qr-image": "^3.2.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.8.1"
